# Copy this file to .env and fill values locally. Never commit .env.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
# Optional but strongly recommended if signature verification is enabled.
FEISHU_SIGNING_SECRET=
# Optional. Public GitHub data works without a token, but the limit is much lower.
GITHUB_TOKEN=
# Required for unattended cloud AI assessment.
OPENAI_API_KEY=
# Balanced default; change via a GitHub Actions repository variable without editing code.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
