# Copy this file to .env and fill values locally. Never commit .env.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
# Optional but strongly recommended if signature verification is enabled.
FEISHU_SIGNING_SECRET=
# Optional. Public GitHub data works without a token, but the limit is much lower.
GITHUB_TOKEN=
# Default AI provider for unattended assessment.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# disabled is faster and cheaper for the daily baseline; compare with enabled using evals.
DEEPSEEK_THINKING=disabled
# Optional OpenAI fallback. Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
